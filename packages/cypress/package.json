{
  "name": "@snapvisor/cypress",
  "description": "Cypress SDK for visual testing with Snapvisor.",
  "version": "8.0.2",
  "author": "Smooth Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/snapvisor-js.git",
    "directory": "packages/cypress"
  },
  "homepage": "https://snapvisor.io/docs",
  "bugs": {
    "url": "https://github.com/argos-ci/argos-javascript/issues"
  },
  "keywords": [
    "argos",
    "argos-ci",
    "cypress",
    "cypress-plugin",
    "testing",
    "e2e-testing",
    "visual-testing",
    "visual-regression",
    "visual-regression-testing",
    "screenshot-testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./support": {
      "types": "./dist/support.d.mts",
      "import": "./dist/support.mjs",
      "default": "./dist/support.mjs"
    },
    "./task": {
      "types": "./dist/task.d.mts",
      "import": "./dist/task.mjs",
      "require": "./dist/task.cjs",
      "default": "./dist/task.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@snapvisor/browser": "workspace:*",
    "@snapvisor/core": "workspace:*",
    "@snapvisor/util": "workspace:*",
    "cypress-wait-until": "^3.0.2"
  },
  "peerDependencies": {
    "cypress": ">=12 <17"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cypress": "^16.1.1",
    "eslint-plugin-cypress": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown",
    "test-e2e": "pnpm exec cypress run",
    "build-e2e": "cypress install",
    "e2e": "UPLOAD_TO_ARGOS=true pnpm run test-e2e",
    "check-types": "tsc",
    "check-format": "prettier --check --ignore-unknown --ignore-path=../../.gitignore --ignore-path=../../.prettierignore .",
    "lint": "eslint ."
  }
}
