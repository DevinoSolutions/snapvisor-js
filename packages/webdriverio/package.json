{
  "name": "@snapvisor/webdriverio",
  "description": "WebdriverIO SDK for visual testing with Snapvisor.",
  "version": "0.8.2",
  "author": "Smooth Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/snapvisor-js.git",
    "directory": "packages/webdriverio"
  },
  "homepage": "https://snapvisor.io/docs",
  "bugs": {
    "url": "https://github.com/argos-ci/argos-javascript/issues"
  },
  "keywords": [
    "argos",
    "argos-ci",
    "webdriverio",
    "webdriverio-plugin",
    "wdio",
    "wdio-plugin",
    "testing",
    "e2e-testing",
    "visual-testing",
    "visual-regression",
    "visual-regression-testing",
    "screenshot-testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "webdriverio": "^6 || ^7 || ^8 || ^9 || ^10"
  },
  "dependencies": {
    "@snapvisor/browser": "workspace:*",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@snapvisor/cli": "workspace:*",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "@wdio/types": "^10.0.0",
    "tsx": "^4.23.15",
    "vitest": "catalog:",
    "webdriverio": "^10.0.0"
  },
  "scripts": {
    "build": "tsdown && cp ./src/index.cjs ./dist",
    "test-e2e": "wdio run ./wdio.conf.ts",
    "argos-upload": "pnpm exec argos upload screenshots --build-name \"argos-webdriverio-e2e-node-$NODE_VERSION-$OS\"",
    "e2e": "pnpm run test-e2e && pnpm run argos-upload",
    "check-types": "tsc",
    "test": "vitest run src",
    "check-format": "prettier --check --ignore-unknown --ignore-path=../../.gitignore --ignore-path=../../.prettierignore .",
    "lint": "eslint ."
  }
}
