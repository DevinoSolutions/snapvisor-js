{
  "name": "@snapvisor/gitlab",
  "private": true,
  "description": "GitLab utilities for visual testing with Argos.",
  "version": "0.8.2",
  "author": "Smooth Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/snapvisor-js.git",
    "directory": "packages/gitlab"
  },
  "homepage": "https://snapvisor.io/docs/gitlab",
  "bugs": {
    "url": "https://github.com/DevinoSolutions/snapvisor-js/issues"
  },
  "keywords": [
    "argos",
    "argos-ci",
    "gitlab",
    "gitlab-ci",
    "merge-request",
    "testing",
    "visual-testing",
    "visual-regression-testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "argos-gitlab": "./bin/argos-gitlab.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc",
    "check-format": "prettier --check --ignore-unknown --ignore-path=../../.gitignore --ignore-path=../../.prettierignore .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@snapvisor/api-client": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
